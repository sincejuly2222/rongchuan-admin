# 前端部署基础路径。
# 部署到域名根路径时填写 /，部署到子路径时填写对应路径，例如 /admin/。
VITE_APP_BASE=/admin/

# 生产环境接口域名。
# 如果生产服务器已经把 /api 反向代理到后端，可以留空。
# 如果没有反向代理，就填写后端地址，例如 http://47.95.20.54。
VITE_API_BASE_URL=

# 本地开发代理目标，仅 npm run dev 生效。
# 开发时前端请求 /api，会被 Vite 代理到这里配置的后端地址。
VITE_DEV_PROXY_TARGET=http://localhost:3000

# 本地开发是否自动恢复登录会话。
# false 表示启动页面时不主动请求刷新登录接口，减少未启动后端时的报错。
VITE_DEV_ENABLE_SESSION_RESTORE=false
